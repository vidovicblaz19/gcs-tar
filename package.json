{
  "name": "gcs-tar",
  "version": "1.1.0",
  "description": "Create tar archives from GCS objects using server-side compose — zero data transfer, near-zero CPU",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "author": "Blaž Vidovič <vidovicblaz19@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidovicblaz19/gcs-tar.git"
  },
  "bugs": {
    "url": "https://github.com/vidovicblaz19/gcs-tar/issues"
  },
  "keywords": [
    "gcs",
    "google-cloud-storage",
    "tar",
    "archive",
    "compose",
    "serverless",
    "cloud-storage"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --platform=node --format=esm --outfile=dist/index.js --external:@google-cloud/storage",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "node --test",
    "test:unit": "node --test test/tar-unit.test.js test/low-memory-unit.test.js",
    "test:integration": "node --test test/create-tar.test.js",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  }
}
